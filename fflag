    -- UI optimization
    ["FFlagDebugDisableUiBlur"] = "true",
    ["FFlagDebugDisableUiAnimations"] = "true",
    
    -- Streaming optimization
    ["FFlagDebugStreamingDisableThrottling"] = "true",
    ["FFlagDebugStreamingForceContent"] = "true",
