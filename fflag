    ["FFlagDebugDisableRenderRetry"] = "true",
    ["FFlagDebugFastGPULightCulling"] = "true",
    ["FFlagDebugDisableLightUpdates"] = "true",
}

-- Apply FFlags function
local function applyFFlags()
    for flag, value in pairs(fflags) do
        pcall(function()
            if setfflag then
                setfflag(flag, value)
            end
        end)
    end
end

-- Optimize game settings
local function optimizeGame()
    -- Lower graphics settings
    settings().Rendering.QualityLevel = 1
    
    -- Disable lighting effects
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BloomEffect") or effect:IsA("SunRaysEffect") or 
           effect:IsA("ColorCorrectionEffect") or effect:IsA("BlurEffect") or
           effect:IsA("DepthOfFieldEffect") then
            effect.Enabled = false
        end
    end
    
    -- Optimize workspace
    workspace.LevelOfDetailMode = Enum.ModelLevelOfDetail.Disabled
    
    -- Lower particle quality
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") then
            obj.Rate = 0
        end
        if obj:IsA("Trail") then
            obj.Enabled = false
        end
        if obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            obj.Enabled = false
        end
    end
end

-- Toggle function
button.MouseButton1Click:Connect(function()
    if not enabled then
        enabled = true
        button.Text = "ENABLED"
        button.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        closeBtn.Visible = true
        
        -- Apply optimizations
        applyFFlags()
        optimizeGame()
        
        -- FPS counter (optional, removes after 3 seconds)
        local fpsLabel = Instance.new("TextLabel")
        fpsLabel.Size = UDim2.new(0, 100, 0, 30)
        fpsLabel.Position = UDim2.new(0, 10, 0, 10)
        fpsLabel.BackgroundTransparency = 0.5
        fpsLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        fpsLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
        fpsLabel.TextSize = 16
        fpsLabel.Font = Enum.Font.GothamBold
        fpsLabel.Parent = screenGui
        
        local fpsConnection
        local lastUpdate = tick()
        local frames = 0
        
        fpsConnection = RunService.RenderStepped:Connect(function()
            frames = frames + 1
            if tick() - lastUpdate >= 1 then
                fpsLabel.Text = "FPS: " .. frames
                frames = 0
                lastUpdate = tick()
            end
        end)
        
        -- Remove FPS counter after 3 seconds
        task.delay(3, function()
            fpsLabel:Destroy()
            fpsConnection:Disconnect()
        end)
        
    else
        -- Already enabled, just close UI
        screenGui:Destroy()
    end
end)

-- Close button just removes UI (keeps optimizations active)
closeBtn.MouseButton1Click:Connect(function()
    screenGui:Destroy()
end)

-- Make button draggable for mobile
local dragging = false
local dragStart, startPos

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = button.Position
    end
end)

button.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - dragStart
        button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        closeBtn.Position = UDim2.new(button.Position.X.Scale, button.Position.X.Offset + 70, button.Position.Y.Scale, button.Position.Y.Offset + 10)
    end
end)

button.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

